@page "/Error"
@using System.Diagnostics

<PageTitle>Fout</PageTitle>

<h1 class="text-danger">Fout.</h1>
<h2 class="text-danger">Er is een fout opgetreden bij het verwerken van je aanvraag.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Development mode</h3>
<p>
    Als je overschakelt naar de <strong>Development</strong> omgeving krijg je meer gedetailleerde informatie over de opgetreden fout te zien.
</p>
<p>
    <strong>De Development omgeving mag niet ingeschakeld staan voor gedeployde applicaties.</strong>
    Dit kan gevoelige informatie uit exceptions tonen aan eindgebruikers.
    Voor lokaal debuggen kan je de <strong>Development</strong> omgeving inschakelen door de <strong>ASPNETCORE_ENVIRONMENT</strong> omgevingsvariabele op <strong>Development</strong> te zetten
    en de app te herstarten.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
