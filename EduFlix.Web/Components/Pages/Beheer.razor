@page "/beheer"
@attribute [Authorize(Roles = "Lecturer")]
@using System.Security.Claims
@using EduFlix.Application
@using EduFlix.Domain
@inject IVideoService VideoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Beheer - EduFlix</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Video uploaden</MudText>

<MudPaper Class="pa-6" Style="max-width:600px">
    <MudTextField @bind-Value="_title" Label="Titel" Required="true" Class="mb-3" />
    <MudTextField @bind-Value="_description" Label="Omschrijving" Lines="3" Class="mb-3" />
    <MudSelect T="int?" @bind-Value="_categoryId" Label="Categorie" Class="mb-3">
        @foreach (var category in _categories)
        {
            <MudSelectItem T="int?" Value="@((int?)category.Id)">@category.Name</MudSelectItem>
        }
    </MudSelect>

    <InputFile id="video-file-input" OnChange="OnFileSelected" accept=".mp4,video/mp4" class="mb-3" />
    @if (_selectedFile is not null)
    {
        <MudText Typo="Typo.body2" Class="mb-3">
            @_selectedFile.Name (@((_selectedFile.Size / 1024.0 / 1024.0).ToString("F1")) MB)
            @if (_durationSeconds is not null)
            {
                <text> — @FormatDuration(_durationSeconds.Value)</text>
            }
        </MudText>
        @if (_thumbnailDataUrl is not null)
        {
            <MudImage Src="@_thumbnailDataUrl" Width="200" Class="mb-3 rounded" />
        }
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Upload"
               Disabled="@(_uploading || _selectedFile is null || string.IsNullOrWhiteSpace(_title))">
        @(_uploading ? "Bezig met uploaden..." : "Uploaden")
    </MudButton>
</MudPaper>

<MudText Typo="Typo.h4" Class="mt-8 mb-4">Mijn video's</MudText>

@if (_myVideos.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Je hebt nog geen video's geüpload.
    </MudAlert>
}
else
{
    <MudTable Items="_myVideos" Hover="true">
        <HeaderContent>
            <MudTh>Titel</MudTh>
            <MudTh>Categorie</MudTh>
            <MudTh>Downloads</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Titel">@context.Title</MudTd>
            <MudTd DataLabel="Categorie">@(context.Category?.Name ?? "-")</MudTd>
            <MudTd DataLabel="Downloads">@context.DownloadCount</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditVideo(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteVideo(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    // demo-schaal: mp4 volstaat, 500 MB is ruim genoeg voor een cursusvideo
    private const long MaxFileSize = 500L * 1024 * 1024;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string _title = "";
    private string? _description;
    private int? _categoryId;
    private IBrowserFile? _selectedFile;
    private string? _error;
    private bool _uploading;
    private string? _userId;
    private IReadOnlyList<Category> _categories = [];
    private IReadOnlyList<Video> _myVideos = [];
    private int? _durationSeconds;
    private byte[]? _thumbnailBytes;
    private string? _thumbnailDataUrl;

    protected override async Task OnInitializedAsync()
    {
        _categories = await VideoService.GetCategoriesAsync();

        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        await LoadMyVideos();
    }

    private async Task LoadMyVideos()
    {
        if (_userId is null) return;
        _myVideos = await VideoService.GetByUploaderAsync(_userId);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        _durationSeconds = null;
        _thumbnailBytes = null;
        _thumbnailDataUrl = null;
        var file = e.File;

        if (!file.Name.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase))
        {
            _error = "Enkel MP4-bestanden zijn toegelaten.";
            _selectedFile = null;
            return;
        }
        if (file.Size > MaxFileSize)
        {
            _error = "Bestand is te groot (max 500 MB).";
            _selectedFile = null;
            return;
        }

        _selectedFile = file;

        // duur + thumbnail worden client-side (in de browser) uit het bestand gehaald,
        // geen server-verwerking nodig
        try
        {
            var capture = await JS.InvokeAsync<VideoCaptureResult>("eduflixVideoCapture.capture", "video-file-input");
            _durationSeconds = capture.DurationSeconds;
            _thumbnailBytes = Convert.FromBase64String(capture.ThumbnailBase64);
            _thumbnailDataUrl = $"data:image/jpeg;base64,{capture.ThumbnailBase64}";
        }
        catch
        {
            // geen blokkerend probleem: upload werkt ook zonder thumbnail/duur
        }
    }

    private record VideoCaptureResult(int DurationSeconds, string ThumbnailBase64);

    private static string FormatDuration(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");

    private async Task Upload()
    {
        if (_selectedFile is null || _userId is null) return;

        _uploading = true;
        _error = null;
        try
        {
            await using var stream = _selectedFile.OpenReadStream(MaxFileSize);
            await VideoService.UploadAsync(new VideoUploadRequest(
                Title: _title,
                Description: _description,
                CategoryId: _categoryId,
                FileName: _selectedFile.Name,
                ContentType: "video/mp4",
                SizeBytes: _selectedFile.Size,
                Content: stream,
                UploadedById: _userId,
                DurationSeconds: _durationSeconds,
                ThumbnailBytes: _thumbnailBytes));

            Snackbar.Add("Video geüpload.", Severity.Success);
            _title = "";
            _description = null;
            _categoryId = null;
            _selectedFile = null;
            _durationSeconds = null;
            _thumbnailBytes = null;
            _thumbnailDataUrl = null;
            await LoadMyVideos();
        }
        catch (Exception ex)
        {
            _error = $"Upload mislukt: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task EditVideo(Video video)
    {
        var parameters = new DialogParameters<EditVideoDialog> { { x => x.Video, video } };
        var dialog = await DialogService.ShowAsync<EditVideoDialog>("Video bewerken", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("Video bijgewerkt.", Severity.Success);
            await LoadMyVideos();
        }
    }

    private async Task DeleteVideo(Video video)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Video verwijderen" },
            { x => x.Message, $"Weet je zeker dat je '{video.Title}' wil verwijderen? Dit kan niet ongedaan gemaakt worden." },
            { x => x.ConfirmText, "Verwijderen" },
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Video verwijderen", parameters);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        await VideoService.DeleteAsync(video.Id);
        Snackbar.Add("Video verwijderd.", Severity.Success);
        await LoadMyVideos();
    }
}
