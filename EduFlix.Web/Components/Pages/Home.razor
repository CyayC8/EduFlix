@page "/"

<PageTitle>EduFlix</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Elevation="0" Class="pa-8 rounded-lg" Style="text-align:center;">
        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Primary" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h3" Class="mt-4">Welkom bij EduFlix</MudText>
        <MudText Typo="Typo.subtitle1" Class="mt-2 mud-text-secondary">
            Het educatieve videoplatform waar lecturers cursusvideo's delen en studenten kijken, leren en terugspoelen.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.VideoLibrary" Href="videos" Class="mt-6">
            Bekijk video's
        </MudButton>
    </MudPaper>
</MudContainer>
