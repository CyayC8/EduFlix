@page "/videos"
@attribute [Authorize]
@using EduFlix.Application
@using EduFlix.Domain
@inject IVideoService VideoService
@inject IBlobStorage BlobStorage
@inject IAnalyticsService AnalyticsService

<PageTitle>Videos - EduFlix</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Videos</MudText>

@if (_videos.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Nog geen video's beschikbaar.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var video in _videos)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <div style="position:relative">
                        @if (_thumbnailUrls.TryGetValue(video.Id, out var thumbnailUrl))
                        {
                            <MudCardMedia Image="@thumbnailUrl" Height="160" />
                        }
                        else
                        {
                            <div style="height:160px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.05)">
                                <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Large" Color="Color.Default" />
                            </div>
                        }
                        @if (video.DurationSeconds is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ma-2"
                                     Style="position:absolute;bottom:0;right:0;background:rgba(0,0,0,0.7);color:white">
                                @FormatDuration(video.DurationSeconds.Value)
                            </MudChip>
                        }
                        <AuthorizeView Roles="Lecturer">
                            <div style="position:absolute;bottom:0;left:0;display:flex;gap:4px" class="ma-2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Visibility">
                                    @_viewCounts.GetValueOrDefault(video.Id)
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Download">
                                    @video.DownloadCount
                                </MudChip>
                            </div>
                        </AuthorizeView>
                    </div>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@video.Title</MudText>
                        @if (video.Category is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-1">@video.Category.Name</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(video.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@video.Description</MudText>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Href="@($"videos/{video.Id}")">
                            Bekijken
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private IReadOnlyList<Video> _videos = [];
    private IReadOnlyDictionary<Guid, int> _viewCounts = new Dictionary<Guid, int>();
    private readonly Dictionary<Guid, string> _thumbnailUrls = [];

    protected override async Task OnInitializedAsync()
    {
        _videos = await VideoService.GetAllAsync();
        if (_videos.Count == 0) return;

        _viewCounts = await AnalyticsService.GetViewCountsAsync(_videos.Select(v => v.Id));

        foreach (var video in _videos.Where(v => v.ThumbnailBlobName is not null))
        {
            var uri = await BlobStorage.GetReadSasUriAsync(video.ThumbnailBlobName!, TimeSpan.FromHours(2));
            _thumbnailUrls[video.Id] = uri.ToString();
        }
    }

    private static string FormatDuration(int seconds) => TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");
}
